{
  "name": "tool/google_tasks_add",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tool/google_tasks_add",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "11111111-1111-4111-8111-cccccccccccc",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "google-tasks-add"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "secret-check",
              "leftValue": "={{ $json.headers['x-astra-secret'] }}",
              "rightValue": "={{ $env.CORTEX_SHARED_SECRET }}",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "22222222-2222-4222-8222-cccccccccccc",
      "name": "Verify Secret",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://tasks.googleapis.com/tasks/v1/lists/{{ encodeURIComponent($('Webhook').item.json.body.list || '@default') }}/tasks",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleTasksOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ title: $('Webhook').item.json.body.title, notes: $('Webhook').item.json.body.notes || '' }, $('Webhook').item.json.body.due ? { due: $('Webhook').item.json.body.due } : {})) }}",
        "options": {}
      },
      "id": "33333333-3333-4333-8333-cccccccccccc",
      "name": "Google Tasks create",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200],
      "notes": "Connect a Google Tasks OAuth2 credential to this node after import."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, id: $json.id }) }}",
        "options": {}
      },
      "id": "44444444-4444-4444-8444-cccccccccccc",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 403,
        "responseBody": "={{ JSON.stringify({ ok: false, error: 'forbidden' }) }}",
        "options": {}
      },
      "id": "55555555-5555-4555-8555-cccccccccccc",
      "name": "Respond 403",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Verify Secret", "type": "main", "index": 0 }]]
    },
    "Verify Secret": {
      "main": [
        [{ "node": "Google Tasks create", "type": "main", "index": 0 }],
        [{ "node": "Respond 403", "type": "main", "index": 0 }]
      ]
    },
    "Google Tasks create": {
      "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false
}

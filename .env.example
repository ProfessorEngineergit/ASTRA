# ═══════════════════════════════════════════════════════════════════════════
#  ASTRA v2 — Environment.  Copy to .env and fill in.  NEVER commit .env.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Public hostname (Caddy TLS + Telegram webhook) ──────────────────────────
# Real domain pointing at this server, or "localhost" for LAN-only dev.
# For the very first test you don't even need this — Telegram long-poll works
# with zero public exposure (see ASTRA_TELEGRAM_MODE below).
ASTRA_DOMAIN=localhost
ACME_EMAIL=you@example.com
ASTRA_TIMEZONE=Europe/Berlin

# ─── Postgres (one instance, multiple DBs: cortex / n8n / langfuse) ──────────
POSTGRES_USER=astra
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=astra

# ─── Shared secret: authenticates cortex ⇄ n8n and inbound webhooks ──────────
CORTEX_SHARED_SECRET=change-me-too

# ─── OpenAI (only LLM for now; gateway lets us add local/Claude later) ───────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o                  # main reasoning / replies
OPENAI_MODEL_SMALL=gpt-4o-mini       # classification + rolling summary
OPENAI_EMBED_MODEL=text-embedding-3-small

# ─── Telegram (your private control + approval channel) ──────────────────────
# Create a bot via @BotFather → token.  Your numeric id via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
ASTRA_TELEGRAM_MODE=poll             # poll = no public URL needed | webhook

# ─── WAHA (WhatsApp HTTP API) — reuse old session from WA-Automate/waha_data ──
WAHA_API_KEY=change-me
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me
WAHA_SESSION=default

# ─── signal-cli-rest-api ─────────────────────────────────────────────────────
SIGNAL_PHONE_NUMBER=+49...

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_ENCRYPTION_KEY=change-me-min-24-chars
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# ─── Langfuse (LLM tracing/debugging) ────────────────────────────────────────
LANGFUSE_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_PUBLIC_KEY=                  # create in Langfuse UI after first start
LANGFUSE_SECRET_KEY=

# ─── Cortex behaviour ────────────────────────────────────────────────────────
ASTRA_DEFER_SECONDS=120               # wait this long for YOU before stepping in
ASTRA_DRY_RUN=false                   # true = never send/book/control, only log (shadow mode)
ASTRA_OWNER_NAME=Bahrian
LOG_LEVEL=INFO

# ═══════════════════════════════════════════════════════════════════════════
#  Assistant capabilities — all OPTIONAL. Leave blank to keep a feature OFF;
#  cortex boots fine and unconfigured features simply no-op.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Voice: transcribe Telegram voice notes with Whisper (uses OPENAI_API_KEY) ─
ASTRA_VOICE_TRANSCRIPTION=true
WHISPER_MODEL=whisper-1

# ─── Home Assistant (active control + "why is X offline") ────────────────────
# Long-lived token: HA → Profil → Long-Lived Access Tokens.
HOME_ASSISTANT_BASE_URL=               # e.g. http://192.168.178.50:8123
HOME_ASSISTANT_TOKEN=

# ─── EduPage (school timetable) ──────────────────────────────────────────────
EDUPAGE_SUBDOMAIN=                     # e.g. "gymnasium-xy" → gymnasium-xy.edupage.org
EDUPAGE_USERNAME=
EDUPAGE_PASSWORD=

# ─── RMV (public transport, free OpenData accessId via https://opendata.rmv.de) ─
RMV_API_KEY=
RMV_HOME_STOP_ID=                      # station extId (Heim-Haltestelle)
RMV_SCHOOL_STOP_ID=                    # station extId (Schule)

# ─── Google Tasks (via the n8n tool/google_tasks_add workflow) ───────────────
GOOGLE_TASKS_ENABLED=false             # set true after importing the n8n workflow + Google cred
GOOGLE_TASKS_LIST=@default

# ─── Morning briefing (proactive "wake up, here's your day" on Telegram) ─────
ASTRA_BRIEFING_ENABLED=false
ASTRA_BRIEFING_TIME=07:00              # local time HH:MM
ASTRA_BRIEFING_CHAT_ID=                # blank = your TELEGRAM_OWNER_CHAT_ID

# ─── Durable knowledge dir (set automatically by compose; usually leave as is) ─
BRAIN_DATA_DIR=/srv/data
